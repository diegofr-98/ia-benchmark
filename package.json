{
  "name": "ia-benchmark",
  "version": "1.0.3",
  "description": "CLI to run AI model benchmarks across multiple providers (OpenAI, Anthropic, Google)",
  "type": "module",
  "bin": "dist/index.js",
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/diegofr-98/ia-benchmark.git"
  },
  "homepage": "https://github.com/diegofr-98/ia-benchmark#readme",
  "bugs": {
    "url": "https://github.com/diegofr-98/ia-benchmark/issues"
  },
  "keywords": [
    "ai",
    "benchmark",
    "llm",
    "openai",
    "anthropic",
    "gemini",
    "cli"
  ],
  "scripts": {
    "prepublishOnly": "npm run build",
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src/",
    "lint:fix": "biome check --write src/",
    "format": "biome format --write src/"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.0",
    "@google/generative-ai": "^0.21.0",
    "cli-table3": "^0.6.5",
    "csv-stringify": "^6.5.1",
    "openai": "^4.73.0",
    "picocolors": "^1.1.1",
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9",
    "@types/node": "^22",
    "@types/yargs": "^17",
    "tsx": "^4.19",
    "typescript": "^5.7"
  }
}
